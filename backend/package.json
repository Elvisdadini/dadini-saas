{
  "name": "dadini-saas-api",
  "version": "1.0.0",
  "private": true,
  "description": "API SaaS de DADINI: ventas, distribucion, inventario y administracion",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env src/reset.js",
    "preparar:produccion": "node --env-file-if-exists=.env src/preparar-produccion.js",
    "migrar:pg": "node --env-file-if-exists=.env scripts/migrar-json-a-postgres.js",
    "test": "node --test test/*.test.js && node --check src/server.js && node --check src/db.js && node --check src/store.js && node --check src/seed.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  }
}
