# Motor local / primario
DADINI_DATA_DIR=G:\DADINI_DATOS\DADINI_SAAS
DADINI_UPLOAD_DIR=G:\DADINI_DATOS\DADINI_SAAS\uploads
PORT=5055
NODE_ENV=development
JWT_SECRET=cambia-este-secreto-en-produccion
CORS_ORIGIN=http://localhost:5180

# PostgreSQL local (DADINI_DB en Disco G: / servicios del sistema)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=DADINI_DB
DB_USER=postgres
DB_PASSWORD=tu_password_local

# Supabase (plan gratuito) - réplica en la nube
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SYNC_TABLE=saas_snapshots
SUPABASE_SYNC_INTERVAL_MS=15000
