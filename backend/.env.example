# Motor local / primario
DADINI_DATA_DIR=G:\DADINI_DATOS\DADINI_SAAS
DADINI_UPLOAD_DIR=G:\DADINI_DATOS\DADINI_SAAS\uploads
PORT=5055
NODE_ENV=development
JWT_SECRET=cambia-este-secreto-en-produccion
CORS_ORIGIN=http://localhost:5180

# PostgreSQL local (DADINI_DB en Disco G: / servicios del sistema)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=DADINI_DB
DB_USER=postgres
DB_PASSWORD=tu_password_local
# Producción: cadena única de Postgres (Supabase: postgres://postgres.[PASSWORD]@db.[REF].supabase.co:5432/postgres)
DATABASE_URL=
DB_SSL=true

# Supabase (plan gratuito) - réplica en la nube
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SYNC_TABLE=saas_snapshots
SUPABASE_SYNC_INTERVAL_MS=15000

# Asistente AI (OpenAI). La llave NUNCA se envía al frontend.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Facturación SIAT / SIN (Bolivia)
# Clave maestra para cifrar credenciales guardadas desde la UI. OBIGATORIA para guardar secretos.
SIAT_SECRET_KEY=
# Feed opcional de normativas (JSON con { fuente, reglas:[...] }). Si no existe usa el registro integrado.
SIAT_NORMATIVA_URL=

# Observabilidad (opcional). Si se define, los errores del frontend se reenvían a Sentry.
SENTRY_DSN=

# API pública y webhooks
API_PUBLIC_RATE_LIMIT=120
